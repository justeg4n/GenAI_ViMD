# ─── Application ──────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-256-bit-random
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4
APP_DEBUG=false

# ─── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vietspeech
POSTGRES_USER=vietspeech_user
POSTGRES_PASSWORD=change-me-strong-password

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CELERY_URL=redis://localhost:6379/1

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-256-bit
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Storage ──────────────────────────────────────────────────
STORAGE_BASE=/app/storage
AUDIO_UPLOAD_MAX_MB=50
MODEL_CACHE_DIR=/app/storage/weights

# ─── Google Drive (Colab) ─────────────────────────────────────
GDRIVE_PROJECT_PATH=/content/drive/MyDrive/vietspeech_ai
GDRIVE_CHECKPOINT_PATH=/content/drive/MyDrive/vietspeech_ai/checkpoints
GDRIVE_DATASET_PATH=/content/drive/MyDrive/vietspeech_ai/datasets

# ─── HuggingFace ──────────────────────────────────────────────
HF_TOKEN=hf_your_token_here
HF_CACHE_DIR=/app/storage/hf_cache

# ─── Models ───────────────────────────────────────────────────
WHISPER_MODEL=openai/whisper-large-v3
PHOWHISPER_MODEL=vinai/PhoWhisper-large
WAV2VEC_MODEL=facebook/wav2vec2-large-960h-lv60-self
WAVLM_MODEL=microsoft/wavlm-large
MBART_MODEL=facebook/mbart-large-50
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# ─── MLflow ───────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=vietspeech_ai

# ─── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Security ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_PER_MINUTE=60
ENCRYPTION_KEY=change-me-32-byte-fernet-key

# ─── Observability ────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
